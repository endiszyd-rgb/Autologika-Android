{
  "expo": {
    "name": "Autologika",
    "slug": "autologika-android",
    "version": "0.13.0",
    "icon": "./assets/app-icon.png",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "pl.autologika.mobile",
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080a0d"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite"
    ]
  }
}
