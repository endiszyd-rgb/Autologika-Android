{
  "expo": {
    "name": "Autologika",
    "slug": "autologika-android",
    "version": "0.23.0",
    "icon": "./assets/app-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "pl.autologika.mobile",
      "versionCode": 37,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080a0d"
      },
      "permissions": [
        "CAMERA",
        "REQUEST_INSTALL_PACKAGES",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pozwól aplikacji Autologika używać mikrofonu do dyktowania notatek warsztatowych.",
          "speechRecognitionPermission": "Pozwól aplikacji Autologika zamieniać mowę na tekst.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ]
    ]
  }
}
